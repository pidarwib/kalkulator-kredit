# ==============================================================================
# Credit Calculator BPR - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local and fill in the values.
# DO NOT commit .env or actual credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kalkulator_kredit?schema=public"

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# A strong random secret key (minimum 32 characters) used for session and token encryption
AUTH_SECRET="change-this-to-a-secure-random-secret-key-min-32-chars"

# ------------------------------------------------------------------------------
# 3. Application Environment
# ------------------------------------------------------------------------------
# Options: development, test, production
NODE_ENV="development"

# Public application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Optional Integrations
# ------------------------------------------------------------------------------
# OpenRouter API Key for optional AI agent sidecar (leave empty if not used)
OPENROUTER_API_KEY=""
